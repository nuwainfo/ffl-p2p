@@ -87,6 +87,21 @@ typedef int (*juice_cb_udp_recv_batch_t)(uintptr_t socket_handle,
                                          juice_udp_recv_datagram_t *datagrams,
                                          size_t capacity, int *socket_error,
                                          void *user_ptr);
+
+#define JUICE_UDP_SEND_AGGREGATE_NOT_HANDLED 0
+#define JUICE_UDP_SEND_AGGREGATE_HANDLED 1
+#define JUICE_UDP_SEND_AGGREGATE_FAILED -1
+
+// Optional aggregate-send hook for platform datapaths. libjuice still owns ICE
+// path selection, the selected socket and send locking; the callback only owns
+// the platform packet-I/O policy. Return NOT_HANDLED to use libjuice's normal
+// aggregate fallback. A failed handled send stores the platform error code in
+// socket_error and any successfully accepted prefix in sent_size.
+typedef int (*juice_cb_udp_send_aggregate_t)(
+    uintptr_t socket_handle, int socket_family,
+    const uint8_t *destination_address, size_t destination_address_size,
+    const char *data, size_t size, size_t segment_size,
+    size_t *sent_size, int *socket_error, void *user_ptr);
 // Called once for a one-shot STUN probe. `mapped` is NULL on failure/timeout.
 // The callback follows the same locking rules as other libjuice callbacks.
 typedef void (*juice_cb_stun_probe_t)(juice_agent_t *agent, const char *server,
@@ -139,9 +154,11 @@ typedef struct juice_config {
 	juice_cb_gathering_done_t cb_gathering_done;
 	juice_cb_recv_t cb_recv;
 	juice_cb_udp_recv_batch_t cb_udp_recv_batch;
+	juice_cb_udp_send_aggregate_t cb_udp_send_aggregate;
 
