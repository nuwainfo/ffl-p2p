+int agent_finish_gathering(juice_agent_t *agent) {
+	if (!agent->conn_impl)
+		return JUICE_ERR_NOT_AVAIL;
+
+	conn_lock(agent);
+	if (agent->gathering_done) {
+		conn_unlock(agent);
+		return JUICE_ERR_SUCCESS;
+	}
+	if (agent->gathering_holds > 0) {
+		conn_unlock(agent);
+		return JUICE_ERR_FAILED;
+	}
+	for (int i = 0; i < agent->entries_count; ++i) {
+		agent_stun_entry_t *entry = agent->entries + i;
+		if ((entry->type == AGENT_STUN_ENTRY_TYPE_SERVER ||
+		     entry->type == AGENT_STUN_ENTRY_TYPE_RELAY) &&
+		    entry->state == AGENT_STUN_ENTRY_STATE_PENDING) {
+			JLOG_INFO("Abandoning pending STUN server or relay entry %d to finish gathering", i);
+			entry->state = AGENT_STUN_ENTRY_STATE_FAILED;
+			entry->next_transmission = 0;
+		}
+	}
+	agent_update_gathering_done(agent);
+	conn_unlock(agent);
+	conn_interrupt(agent);
+	return JUICE_ERR_SUCCESS;
+}
