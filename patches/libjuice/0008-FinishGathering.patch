 }
 
+static volatile int swallowed_stun_requests;
+
+// Plays a STUN server that never answers, as an IPv6 STUN address does when the
+// host has an IPv6 address but no working IPv6 route.
+static int swallow_stun_requests(uintptr_t socket_handle, int socket_family,
+                                 const uint8_t *destination_address,
+                                 size_t destination_address_size, const char *data, size_t size,
+                                 int *socket_error, void *user_ptr) {
+    (void)socket_handle;
+    (void)socket_family;
+    (void)destination_address;
+    (void)destination_address_size;
+    (void)socket_error;
+    (void)user_ptr;
+    if (!is_stun_binding_request(data, size))
+        return JUICE_UDP_SEND_NOT_HANDLED;
+
+    ++swallowed_stun_requests;
+    return JUICE_UDP_SEND_HANDLED;
+}
+
+static int test_finish_gathering_with_unanswered_stun(void) {
+    gathering_done_count = 0;
+    swallowed_stun_requests = 0;
+
+    juice_config_t config;
+    memset(&config, 0, sizeof(config));
+    config.concurrency_mode = JUICE_CONCURRENCY_MODE_POLL;
+    config.bind_address = "127.0.0.1";
+    config.stun_server_host = "127.0.0.1";
+    config.stun_server_port = 3478;
+    config.cb_gathering_done = on_gathering_done;
+    config.cb_udp_send = swallow_stun_requests;
+
+    char sdp[JUICE_MAX_SDP_STRING_LEN];
+    juice_agent_t *agent = juice_create(&config);
+    if (!agent)
+        return -1;
+
+    if (juice_finish_gathering(agent) != JUICE_ERR_NOT_AVAIL)
+        goto fail;
+    if (juice_hold_gathering(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (juice_gather_candidates(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (juice_finish_gathering(agent) != JUICE_ERR_FAILED)
+        goto fail;
+    if (juice_release_gathering(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (wait_for(&swallowed_stun_requests, 1, 1000) != 0)
+        goto fail;
+    if (gathering_done_count != 0)
+        goto fail;
+    if (juice_get_local_description(agent, sdp, sizeof(sdp)) != JUICE_ERR_SUCCESS ||
+        strstr(sdp, "a=end-of-candidates"))
+        goto fail;
+
+    if (juice_finish_gathering(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (wait_for(&gathering_done_count, 1, 1000) != 0)
+        goto fail;
+    if (juice_get_local_description(agent, sdp, sizeof(sdp)) != JUICE_ERR_SUCCESS ||
+        !strstr(sdp, "a=end-of-candidates") || !strstr(sdp, " typ host"))
+        goto fail;
+
+    // The abandoned server transaction must stop retransmitting (next retry is 1 s out).
+    int swallowed_at_finish = swallowed_stun_requests;
+    sleep_ms(1500);
+    if (swallowed_stun_requests != swallowed_at_finish)
+        goto fail;
+
+    if (juice_finish_gathering(agent) != JUICE_ERR_SUCCESS || gathering_done_count != 1)
+        goto fail;
+    if (juice_hold_gathering(agent) != JUICE_ERR_FAILED)
+        goto fail;
+
+    juice_destroy(agent);
+    return 0;
+fail:
+    juice_destroy(agent);
+    return -1;
+}
