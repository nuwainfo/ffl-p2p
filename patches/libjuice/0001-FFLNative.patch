+
+    juice_server_config_t sc1;
+    juice_server_config_t sc2;
+    memset(&sc1, 0, sizeof(sc1));
+    memset(&sc2, 0, sizeof(sc2));
+    sc1.bind_address = "127.0.0.1";
+    sc2.bind_address = "127.0.0.1";
+    sc1.port = 0;
+    sc2.port = 0;
+    juice_server_t *server1 = juice_server_create(&sc1);
+    juice_server_t *server2 = juice_server_create(&sc2);
+    if (!server1 || !server2)
+        goto fail_servers;
+
+    uint16_t server_port1 = juice_server_get_port(server1);
+    uint16_t server_port2 = juice_server_get_port(server2);
+    if (!server_port1 || !server_port2 || server_port1 == server_port2)
+        goto fail_servers;
+
+    juice_config_t config;
+    memset(&config, 0, sizeof(config));
+    config.concurrency_mode = mode;
+    config.bind_address = "127.0.0.1";
+    config.cb_candidate = on_candidate;
+    config.cb_gathering_done = on_gathering_done;
+    juice_agent_t *agent = juice_create(&config);
+    if (!agent)
+        goto fail_servers;
+    if (juice_gather_candidates(agent) != JUICE_ERR_SUCCESS)
+        goto fail_agent;
+    if (wait_for(&gathering_done_count, 1, 1000) != 0)
+        goto fail_agent;
+    uint16_t local_port = 0;
+    if (juice_get_local_port(agent, &local_port) != JUICE_ERR_SUCCESS || local_port == 0)
+        goto fail_agent;
+
+    int baseline_candidates = candidate_count;
+    if (juice_probe_stun(agent, "127.0.0.1", server_port1, on_probe, NULL) != JUICE_ERR_SUCCESS)
+        goto fail_agent;
+    if (juice_probe_stun(agent, "127.0.0.1", server_port2, on_probe, NULL) != JUICE_ERR_SUCCESS)
+        goto fail_agent;
+    if (wait_for(&probe_count, 2, 3000) != 0)
+        goto fail_agent;
+    if (!probe_mapped_ports[0] || probe_mapped_ports[0] != probe_mapped_ports[1])
+        goto fail_agent;
+    if (probe_mapped_ports[0] != local_port)
+        goto fail_agent;
+    if (candidate_count != baseline_candidates)
+        goto fail_agent;
+
+    // Probe entries must be reusable for periodic netchecks. More than the
+    // configured probe-slot count is intentionally exercised here.
+    for (int i = 0; i < 20; ++i) {
+        uint16_t target_port = (i & 1) ? server_port1 : server_port2;
+        int expected = probe_count + 1;
+        if (juice_probe_stun(agent, "127.0.0.1", target_port, on_probe, NULL) !=
+            JUICE_ERR_SUCCESS)
+            goto fail_agent;
+        if (wait_for(&probe_count, expected, 3000) != 0)
+            goto fail_agent;
+    }
+    if (candidate_count != baseline_candidates)
+        goto fail_agent;
+
+    juice_destroy(agent);
+    juice_server_destroy(server1);
+    juice_server_destroy(server2);
+    return 0;
+fail_agent:
+    juice_destroy(agent);
+fail_servers:
+    if (server1)
+        juice_server_destroy(server1);
+    if (server2)
+        juice_server_destroy(server2);
+    return -1;
+}
+#endif
+
+int main(void) {
+    juice_set_log_level(JUICE_LOG_LEVEL_WARN);
+    const juice_concurrency_mode_t modes[] = {
+        JUICE_CONCURRENCY_MODE_POLL,
+        JUICE_CONCURRENCY_MODE_THREAD,
+        JUICE_CONCURRENCY_MODE_MUX,
+    };
+    const char *mode_names[] = {"poll", "thread", "mux"};
+    for (size_t i = 0; i < sizeof(modes) / sizeof(modes[0]); ++i) {
+        printf("Running FFL gathering/mapped-candidate test (%s)...\n", mode_names[i]);
+        if (test_hold_and_mapped_candidate(modes[i])) {
+            fprintf(stderr, "FFL gathering/mapped-candidate test failed (%s)\n", mode_names[i]);
+            return 1;
+        }
+#ifndef NO_SERVER
+        printf("Running FFL same-socket multi-STUN test (%s)...\n", mode_names[i]);
+        if (test_same_socket_stun_probes(modes[i])) {
+            fprintf(stderr, "FFL same-socket multi-STUN test failed (%s)\n", mode_names[i]);
+            return 1;
+        }
+#endif
+    }
+    printf("FFL extension tests passed\n");
+    return 0;
+}
