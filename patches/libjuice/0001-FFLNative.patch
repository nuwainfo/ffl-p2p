+int agent_hold_gathering(juice_agent_t *agent) {
+	conn_lock(agent);
+	if (agent->gathering_done) {
+		conn_unlock(agent);
+		return JUICE_ERR_FAILED;
+	}
+	++agent->gathering_holds;
+	conn_unlock(agent);
+	return JUICE_ERR_SUCCESS;
+}
+
+int agent_release_gathering(juice_agent_t *agent) {
+	conn_lock(agent);
+	if (agent->gathering_holds == 0) {
+		conn_unlock(agent);
+		return JUICE_ERR_INVALID;
+	}
+	--agent->gathering_holds;
+	if (agent->conn_impl)
+		agent_update_gathering_done(agent);
+	conn_unlock(agent);
+	if (agent->conn_impl)
+		conn_interrupt(agent);
+	return JUICE_ERR_SUCCESS;
+}
+
+int agent_get_local_port(juice_agent_t *agent, uint16_t *port) {
+	if (!agent->conn_impl)
+		return JUICE_ERR_NOT_AVAIL;
+
+	addr_record_t records[ICE_MAX_CANDIDATES_COUNT];
+	int records_count = conn_get_addrs(agent, records, ICE_MAX_CANDIDATES_COUNT);
+	if (records_count <= 0)
+		return JUICE_ERR_NOT_AVAIL;
+
+	for (int i = 0; i < records_count; ++i) {
+		uint16_t value = addr_get_port((const struct sockaddr *)&records[i].addr);
+		if (value) {
+			*port = value;
+			return JUICE_ERR_SUCCESS;
+		}
+	}
+	return JUICE_ERR_NOT_AVAIL;
+}
+
+int agent_add_local_mapped_candidate(juice_agent_t *agent, const char *address, uint16_t port) {
+	if (!agent->conn_impl)
+		return JUICE_ERR_NOT_AVAIL;
+	if (!addr_is_numeric_hostname(address))
+		return JUICE_ERR_INVALID;
+
+	char service[8];
+	snprintf(service, sizeof(service), "%hu", port);
+	addr_record_t record;
+	if (addr_resolve(address, service, SOCK_DGRAM, &record, 1) != 1)
+		return JUICE_ERR_INVALID;
+
+	conn_lock(agent);
+	if (agent->gathering_done) {
+		conn_unlock(agent);
+		return JUICE_ERR_FAILED;
+	}
+	int ret = agent_add_local_reflexive_candidate(
+	    agent, ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE, &record);
+	conn_unlock(agent);
+	if (ret < 0)
+		return JUICE_ERR_FAILED;
+	conn_interrupt(agent);
+	return JUICE_ERR_SUCCESS;
+}
+
+static void agent_finish_stun_probe(juice_agent_t *agent, agent_stun_entry_t *entry,
+                                    const addr_record_t *mapped) {
+	juice_cb_stun_probe_t cb = entry->probe_callback;
+	void *user_ptr = entry->probe_user_ptr;
+	entry->probe_callback = NULL;
+	entry->probe_user_ptr = NULL;
+	entry->next_transmission = 0;
+	entry->state = mapped ? AGENT_STUN_ENTRY_STATE_SUCCEEDED : AGENT_STUN_ENTRY_STATE_FAILED;
+	if (!cb)
+		return;
+
+	char server_str[ADDR_MAX_STRING_LEN];
+	char mapped_str[ADDR_MAX_STRING_LEN];
+	if (addr_record_to_string(&entry->record, server_str, sizeof(server_str)) < 0)
+		server_str[0] = '\0';
+	const char *mapped_ptr = NULL;
+	if (mapped && addr_record_to_string(mapped, mapped_str, sizeof(mapped_str)) >= 0)
+		mapped_ptr = mapped_str;
+	cb(agent, server_str, mapped_ptr, user_ptr);
+}
+
+int agent_probe_stun(juice_agent_t *agent, const char *host, uint16_t port,
+                     juice_cb_stun_probe_t cb, void *user_ptr) {
+	if (!agent->conn_impl)
+		return JUICE_ERR_NOT_AVAIL;
+	if (!port)
+		port = 3478;
+
+	char service[8];
+	snprintf(service, sizeof(service), "%hu", port);
+	addr_record_t records[2];
+	int records_count = addr_resolve(host, service, SOCK_DGRAM, records, 2);
+	if (records_count <= 0)
+		return JUICE_ERR_FAILED;
+
+	// Prefer IPv4 to make observations from multiple IPv4 STUN servers directly comparable.
+	addr_record_t *record = &records[0];
+	for (int i = 0; i < records_count; ++i) {
+		if (records[i].addr.ss_family == AF_INET) {
+			record = &records[i];
+			break;
+		}
+	}
+
+	conn_lock(agent);
+	agent_stun_entry_t *entry = NULL;
+	for (int i = 0; i < agent->entries_count; ++i) {
+		agent_stun_entry_t *candidate = agent->entries + i;
+		if (candidate->type == AGENT_STUN_ENTRY_TYPE_PROBE &&
+		    candidate->state != AGENT_STUN_ENTRY_STATE_PENDING &&
+		    candidate->probe_callback == NULL) {
+			entry = candidate;
+			break;
+		}
+	}
+	if (!entry) {
+		if (agent->entries_count >= MAX_STUN_ENTRIES_COUNT) {
+			conn_unlock(agent);
+			return JUICE_ERR_NOT_AVAIL;
+		}
+		entry = agent->entries + agent->entries_count++;
+	}
+	memset(entry, 0, sizeof(*entry));
+	entry->type = AGENT_STUN_ENTRY_TYPE_PROBE;
+	entry->state = AGENT_STUN_ENTRY_STATE_PENDING;
+	entry->record = *record;
+	entry->probe_callback = cb;
+	entry->probe_user_ptr = user_ptr;
+	juice_random(entry->transaction_id, STUN_TRANSACTION_ID_SIZE);
+	entry->transaction_id_expired = false;
+	agent_arm_transmission(agent, entry, 0);
+	conn_unlock(agent);
+	conn_interrupt(agent);
+	return JUICE_ERR_SUCCESS;
+}
