diff --git a/test/ffl-extensions.c b/test/ffl-extensions.c
new file mode 100644
index 0000000..9742b00
--- /dev/null
+++ b/test/ffl-extensions.c
@@ -0,0 +1,239 @@
+/**
+ * FFL native-direct extension tests for libjuice.
+ */
+#include "juice/juice.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+static void sleep_ms(unsigned int ms) { Sleep(ms); }
+#else
+#include <unistd.h>
+static void sleep_ms(unsigned int ms) { usleep(ms * 1000); }
+#endif
+
+static volatile int gathering_done_count;
+static volatile int candidate_count;
+static volatile int probe_count;
+static uint16_t probe_mapped_ports[2];
+static bool mapped_candidate_seen;
+
+static void on_candidate(juice_agent_t *agent, const char *sdp, void *user_ptr) {
+    (void)agent;
+    (void)user_ptr;
+    ++candidate_count;
+    if (strstr(sdp, " typ srflx ") && strstr(sdp, "203.0.113.10"))
+        mapped_candidate_seen = true;
+}
+
+static void on_gathering_done(juice_agent_t *agent, void *user_ptr) {
+    (void)agent;
+    (void)user_ptr;
+    ++gathering_done_count;
+}
+
+static uint16_t parse_port(const char *address) {
+    if (!address)
+        return 0;
+    const char *p = strrchr(address, ':');
+    if (!p)
+        return 0;
+    return (uint16_t)strtoul(p + 1, NULL, 10);
+}
+
+static void on_probe(juice_agent_t *agent, const char *server, const char *mapped, void *user_ptr) {
+    (void)agent;
+    (void)server;
+    (void)user_ptr;
+    int index = probe_count;
+    if (index < 2)
+        probe_mapped_ports[index] = parse_port(mapped);
+    ++probe_count;
+}
+
+static int wait_for(volatile int *value, int target, unsigned int timeout_ms) {
+    while (timeout_ms > 0) {
+        if (*value >= target)
+            return 0;
+        sleep_ms(10);
+        timeout_ms = timeout_ms > 10 ? timeout_ms - 10 : 0;
+    }
+    return -1;
+}
+
+static int test_hold_and_mapped_candidate(juice_concurrency_mode_t mode) {
+    gathering_done_count = 0;
+    candidate_count = 0;
+    mapped_candidate_seen = false;
+
+    juice_config_t config;
+    memset(&config, 0, sizeof(config));
+    config.concurrency_mode = mode;
+    config.cb_candidate = on_candidate;
+    config.cb_gathering_done = on_gathering_done;
+
+    juice_agent_t *agent = juice_create(&config);
+    if (!agent)
+        return -1;
+
+    uint16_t port = 0;
+    if (juice_get_local_port(agent, &port) != JUICE_ERR_NOT_AVAIL)
+        goto fail;
+    if (juice_release_gathering(agent) != JUICE_ERR_INVALID)
+        goto fail;
+    if (juice_hold_gathering(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (juice_hold_gathering(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (juice_gather_candidates(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (juice_get_local_port(agent, &port) != JUICE_ERR_SUCCESS || port == 0)
+        goto fail;
+    if (gathering_done_count != 0)
+        goto fail;
+    if (juice_add_local_mapped_candidate(agent, "not-an-ip", 45678) != JUICE_ERR_INVALID)
+        goto fail;
+    if (juice_add_local_mapped_candidate(agent, "203.0.113.10", 45678) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (!mapped_candidate_seen)
+        goto fail;
+    int candidates_after_mapping = candidate_count;
+    if (juice_add_local_mapped_candidate(agent, "203.0.113.10", 45678) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (candidate_count != candidates_after_mapping)
+        goto fail;
+    if (juice_release_gathering(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (gathering_done_count != 0)
+        goto fail;
+    if (juice_release_gathering(agent) != JUICE_ERR_SUCCESS)
+        goto fail;
+    if (wait_for(&gathering_done_count, 1, 1000) != 0)
+        goto fail;
+    if (juice_release_gathering(agent) != JUICE_ERR_INVALID)
+        goto fail;
+    if (juice_hold_gathering(agent) != JUICE_ERR_FAILED)
+        goto fail;
+
+    juice_destroy(agent);
+    return 0;
+fail:
+    juice_destroy(agent);
+    return -1;
+}
+
+#ifndef NO_SERVER
+static int test_same_socket_stun_probes(juice_concurrency_mode_t mode) {
+    gathering_done_count = 0;
+    candidate_count = 0;
+    probe_count = 0;
