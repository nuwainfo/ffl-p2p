diff --git a/include/juice/juice.h b/include/juice/juice.h
index ea5e04d..d3a7aab 100644
--- a/include/juice/juice.h
+++ b/include/juice/juice.h
@@ -66,6 +66,27 @@ typedef void (*juice_cb_candidate_t)(juice_agent_t *agent, const char *sdp, void
 typedef void (*juice_cb_gathering_done_t)(juice_agent_t *agent, void *user_ptr);
 typedef void (*juice_cb_recv_t)(juice_agent_t *agent, const char *data, size_t size,
                                 void *user_ptr);
+
+#define JUICE_UDP_RECV_BATCH_CAPACITY 64
+#define JUICE_UDP_RECV_ADDRESS_STORAGE_SIZE 128
+
+typedef struct juice_udp_recv_datagram {
+	const char *data;
+	size_t size;
+	uint8_t source_address[JUICE_UDP_RECV_ADDRESS_STORAGE_SIZE];
+	size_t source_address_size;
+} juice_udp_recv_datagram_t;
+
+// Optional socket-ready receive hook. The callback is invoked synchronously from
+// libjuice's UDP poll thread and may return multiple datagrams from one socket
+// receive operation. Pointers in the returned datagrams must remain valid while
+// libjuice synchronously processes the returned batch (that is, until the next
+// invocation of this callback). A negative return indicates a socket
+// error and stores the platform error code in socket_error.
+typedef int (*juice_cb_udp_recv_batch_t)(uintptr_t socket_handle,
+                                         juice_udp_recv_datagram_t *datagrams,
+                                         size_t capacity, int *socket_error,
+                                         void *user_ptr);
 // Called once for a one-shot STUN probe. `mapped` is NULL on failure/timeout.
 // The callback follows the same locking rules as other libjuice callbacks.
 typedef void (*juice_cb_stun_probe_t)(juice_agent_t *agent, const char *server,
@@ -117,8 +138,10 @@ typedef struct juice_config {
 	juice_cb_candidate_t cb_candidate;
 	juice_cb_gathering_done_t cb_gathering_done;
 	juice_cb_recv_t cb_recv;
+	juice_cb_udp_recv_batch_t cb_udp_recv_batch;
 
 	void *user_ptr;
+	void *udp_recv_batch_user_ptr;
 
 } juice_config_t;
 
