+static int udp_sendto_segments(socket_t sock, int socket_family, const char *data, size_t size,
+                               size_t segment_size, const addr_record_t *dst) {
+	size_t offset = 0;
+	while (offset < size) {
+		size_t segment = size - offset;
+		if (segment > segment_size)
+			segment = segment_size;
+		int ret = udp_sendto_family(sock, socket_family, data + offset, segment, dst);
+		if (ret < 0)
+			return ret;
+		offset += segment;
+	}
+	return (int)size;
+}
+
+int udp_sendto_aggregate(socket_t sock, int socket_family, const char *data, size_t size,
+                         size_t segment_size, const addr_record_t *dst) {
+	if (!data || size == 0 || segment_size == 0 || segment_size > size)
+		return -1;
+	if (size <= segment_size)
+		return udp_sendto_family(sock, socket_family, data, size, dst);
+
+#ifdef _WIN32
+	// UDP_SEND_MSG_SIZE was added to the Windows 10 20H1 SDK. Define the
+	// documented socket-option value so builds that intentionally retain
+	// libjuice's Windows 7 _WIN32_WINNT floor can still use it at runtime.
+#ifndef UDP_SEND_MSG_SIZE
+#define UDP_SEND_MSG_SIZE 2
+#endif
+	DWORD message_size = (DWORD)segment_size;
+	if (setsockopt(sock, IPPROTO_UDP, UDP_SEND_MSG_SIZE, (const char *)&message_size,
+	               sizeof(message_size)) == 0) {
+		addr_record_t tmp = *dst;
+		if (socket_family == AF_INET6 && tmp.addr.ss_family == AF_INET)
+			addr_map_inet6_v4mapped(&tmp.addr, &tmp.len);
+
+		int ret = sendto(sock, data, (int)size, 0, (const struct sockaddr *)&tmp.addr, tmp.len);
+		int send_error = ret < 0 ? sockerrno : 0;
+		DWORD disabled = 0;
+		if (setsockopt(sock, IPPROTO_UDP, UDP_SEND_MSG_SIZE, (const char *)&disabled,
+		               sizeof(disabled)) != 0)
+			JLOG_WARN("Unable to disable UDP send segmentation, errno=%d", sockerrno);
+		if (ret >= 0)
+			return ret;
+
+		WSASetLastError(send_error);
+		if (send_error != WSAEINVAL && send_error != WSAENOPROTOOPT &&
+		    send_error != WSAEMSGSIZE)
+			return ret;
+	}
+#endif
+
+	return udp_sendto_segments(sock, socket_family, data, size, segment_size, dst);
+}
