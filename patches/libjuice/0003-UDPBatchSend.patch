+JUICE_EXPORT int juice_send_aggregate(juice_agent_t *agent, const char *data, size_t size,
+                                      size_t segment_size) {
+	if (!agent || (!data && size) || segment_size == 0 || segment_size > size)
+		return JUICE_ERR_INVALID;
+
+	int ret = agent_send_aggregate(agent, data, size, segment_size, 0);
+	if (ret >= 0)
+		return JUICE_ERR_SUCCESS;
+	if (ret == -SEAGAIN || ret == -SEWOULDBLOCK)
+		return JUICE_ERR_AGAIN;
+	if (ret == -SEMSGSIZE)
+		return JUICE_ERR_TOO_LARGE;
+	return JUICE_ERR_FAILED;
+}
