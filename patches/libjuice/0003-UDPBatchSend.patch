 }
 
+int agent_send_aggregate(juice_agent_t *agent, const char *data, size_t size, size_t segment_size,
+                         int ds) {
+	if (!data || size == 0 || segment_size == 0 || segment_size > size)
+		return -1;
+
+	// The optimized aggregate path is only valid for a direct UDP candidate.
+	// TURN and ICE-TCP add their own framing, so preserve datagram boundaries by
+	// sending each segment through the regular path there.
+	agent_stun_entry_t *selected_entry = atomic_load(&agent->selected_entry);
+	if (!selected_entry) {
+		JLOG_ERROR("Send while ICE is not connected");
+		return -1;
+	}
+
+	if (!selected_entry->relay_entry && selected_entry->record.socktype == SOCK_DGRAM)
+		return conn_send_aggregate(agent, &selected_entry->record, data, size, segment_size, ds);
+
+	size_t offset = 0;
+	while (offset < size) {
+		size_t segment = size - offset;
+		if (segment > segment_size)
+			segment = segment_size;
+		int ret = agent_send(agent, data + offset, segment, ds);
+		if (ret < 0)
+			return ret;
+		offset += segment;
+	}
+	return (int)size;
+}
