index d8e9d65..cb4e1ec 100644
--- a/src/conn_poll.c
+++ b/src/conn_poll.c
@@ -663,6 +663,40 @@ int conn_poll_send(juice_agent_t *agent, const addr_record_t *dst, const char *d
 	return ret;
 }
 
+int conn_poll_send_aggregate(juice_agent_t *agent, const addr_record_t *dst, const char *data,
+                             size_t size, size_t segment_size, int ds) {
+	conn_impl_t *conn_impl = agent->conn_impl;
+	if (dst->socktype != SOCK_DGRAM)
+		return -1;
+
+	mutex_lock(&conn_impl->send_mutex);
+
+	if (conn_impl->send_ds >= 0 && conn_impl->send_ds != ds) {
+		JLOG_VERBOSE("Setting Differentiated Services field to 0x%X", ds);
+		if (udp_set_diffserv(conn_impl->udp_sock, ds) == 0)
+			conn_impl->send_ds = ds;
+		else
+			conn_impl->send_ds = -1;
+	}
+
+	int ret = udp_sendto_aggregate(conn_impl->udp_sock, conn_impl->udp_family, data, size,
+	                               segment_size, dst);
+	if (ret < 0)
+		ret = -sockerrno;
+
+	if (ret < 0) {
+		if (ret == -SEAGAIN || ret == -SEWOULDBLOCK)
+			JLOG_INFO("Aggregate send failed, buffer is full");
+		else if (ret == -SEMSGSIZE)
+			JLOG_WARN("Aggregate send failed, datagram is too large");
+		else
+			JLOG_WARN("Aggregate send failed, errno=%d", -ret);
+	}
+
+	mutex_unlock(&conn_impl->send_mutex);
+	return ret;
+}
