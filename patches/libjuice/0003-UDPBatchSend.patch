+int conn_send_aggregate(juice_agent_t *agent, const addr_record_t *dst, const char *data,
+                        size_t size, size_t segment_size, int ds) {
+	if (!agent->conn_impl)
+		return -1;
+
+	if (agent->config.concurrency_mode == JUICE_CONCURRENCY_MODE_POLL)
+		return conn_poll_send_aggregate(agent, dst, data, size, segment_size, ds);
+
+	// Other concurrency modes keep the existing semantics. FFL uses POLL, but
+	// this fallback keeps the extension safe for generic libjuice callers.
+	size_t offset = 0;
+	while (offset < size) {
+		size_t segment = size - offset;
+		if (segment > segment_size)
+			segment = segment_size;
+		int ret = conn_send(agent, dst, data + offset, segment, ds);
+		if (ret < 0)
+			return ret;
+		offset += segment;
+	}
+	return (int)size;
+}
